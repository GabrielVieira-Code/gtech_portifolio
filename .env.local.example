# ── AWS ──────────────────────────────────────────────────────────────────────
# Crie um IAM User com permissão sns:Publish APENAS neste tópico
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ARN do tópico SNS (ex: arn:aws:sns:us-east-1:123456789012:contact-notifications)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:contact-notifications
